{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["es2023"],
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["bun"]
  },
  "include": ["server/*.ts", "bin"],
  "exclude": ["server/*.test.ts"]
}
